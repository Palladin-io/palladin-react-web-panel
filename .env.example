# Required for local development.
# Explicit build approval for self-hosted non-loopback HTTP API/SignalR.
# Does not waive the separate HTTP consent in extension Settings.
PALLADIN_ALLOW_INSECURE_HTTP_CONNECTIONS=false
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/notifications

# Optional exact Chromium extension ID for shared unlock; empty disables the channel.
# Supply deployment-owned values in ignored environment files, never in this template.
VITE_SHARED_UNLOCK_EXTENSION_ID=
# Optional exact Firefox Gecko ID. Empty disables Firefox shared unlock and its CSP scheme.
VITE_SHARED_UNLOCK_FIREFOX_EXTENSION_ID=
# Optional exact Safari bundle/team runtime ID. Empty disables Safari shared unlock.
# Example syntax: com.example.Extension (ABCDEFGHIJ); do not percent-encode the space.
VITE_SHARED_UNLOCK_SAFARI_EXTENSION_ID=

# Optional integrations.
VITE_PUBLIC_ASSET_URL=http://localhost:4566/palladin-local-public-assets
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Enable only after the final legal release review. A key alone never enables capture.
VITE_CLIENT_ANALYTICS_RELEASED=false

# Firebase Cloud Messaging (Web Push) — all optional.
# When any value is empty, web push is disabled and only SignalR is used.
# These are public Firebase Web config values, but keep them out of source
# control via your own .env.local / .env.staging / .env.production.
# Obtain them from the Firebase Console → Project settings → General (config)
# and → Cloud Messaging (Web Push certificates → VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Public, reviewed app/domain associations. Empty disables both documents.
# Provide all four values per deployment, never reuse production signing IDs on staging.
PALLADIN_APP_LINK_ENVIRONMENT=
PALLADIN_APP_LINK_APPLE_APP_ID=
PALLADIN_APP_LINK_ANDROID_PACKAGE=
PALLADIN_APP_LINK_ANDROID_SHA256=

# Reviewed public store URLs. Empty hides the download fallback.
VITE_APPLE_APP_STORE_URL=
VITE_GOOGLE_PLAY_STORE_URL=
